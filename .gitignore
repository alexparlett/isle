# Generated at install time, not committed — keeps binaries out of the repo.
config/hypr/wallpapers/

# Per-machine overrides, sourced by hyprland.lua if present.
config/hypr/local.lua

# Backups install.sh makes when it finds a real file where a symlink should go.
*.bak-*

# Editor and tooling state.
.idea/
.vscode/
.claude/

# Generated by install.sh from hypridle.conf.in; edited by System Settings.
config/hypr/hypridle.conf

# Scratch copies of third-party source fetched for inspection.
hm_config.py
lua_mode.py
