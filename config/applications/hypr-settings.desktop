[Desktop Entry]
Type=Application
Name=System Settings
GenericName=Settings
Comment=Appearance, keyboard, mouse, display, sound, power and defaults
Exec=python3 %h/.config/hypr/settings/system-settings.py
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;GTK;
Keywords=settings;preferences;control;hyprland;keyboard;mouse;display;sound;power;defaults;
StartupNotify=true
StartupWMClass=dev.parlett.systemsettings
