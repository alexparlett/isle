################################################################################
#  hyprlock — Catppuccin Mocha
################################################################################

general {
    hide_cursor = true
    ignore_empty_input = true
    immediate_render = true
    fractional_scaling = 0
}

auth {
    fingerprint:enabled = false
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.011
    contrast = 0.9
    brightness = 0.6
    vibrancy = 0.17
}

# --- Clock -------------------------------------------------------------------
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = {{rgba:foreground}}
    font_size = 120
    font_family = JetBrainsMono Nerd Font ExtraBold
    position = 0, 180
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 4
    shadow_color = {{rgba:shadow:aa}}
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %e %B"
    color = {{rgba:dim}}
    font_size = 22
    font_family = JetBrainsMono Nerd Font
    position = 0, 80
    halign = center
    valign = center
}

# --- User --------------------------------------------------------------------
label {
    monitor =
    text =    $USER
    color = {{rgba:accent}}
    font_size = 16
    font_family = JetBrainsMono Nerd Font
    position = 0, -60
    halign = center
    valign = center
}

# --- Password ----------------------------------------------------------------
input-field {
    monitor =
    size = 340, 55
    outline_thickness = 2
    dots_size = 0.28
    dots_spacing = 0.3
    dots_center = true
    dots_rounding = -1

    outer_color = {{rgba:accent}}
    inner_color = {{rgba:background:dd}}
    font_color = {{rgba:foreground}}
    check_color = {{rgba:accent_alt}}
    fail_color = {{rgba:urgent}}

    fade_on_empty = false
    placeholder_text = <span foreground="#{{css:muted}}"><i>Password…</i></span>
    fail_text = <span foreground="#{{css:urgent}}">$FAIL ($ATTEMPTS)</span>
    hide_input = false
    rounding = 12

    position = 0, -130
    halign = center
    valign = center
}

# --- Status line -------------------------------------------------------------
label {
    monitor =
    text =   Enter to unlock  ·    Esc to clear
    color = {{rgba:muted}}
    font_size = 13
    font_family = JetBrainsMono Nerd Font
    position = 0, 40
    halign = center
    valign = bottom
}
