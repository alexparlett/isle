# kitty — Catppuccin Mocha
#
# Chosen over Alacritty for one concrete reason: the kitty graphics protocol.
# Yazi renders real image, video and PDF thumbnails through it; Alacritty has
# no image support by design, so previews there degrade to ASCII via chafa.
# Tabs, splits and ligatures come along for free.
#
# Alacritty stays installed as a fallback — nothing here depends on kitty
# except the `term` in binds-shared.lua.

# --- Font ---------------------------------------------------------------
font_family      JetBrainsMono Nerd Font
bold_font        JetBrainsMono Nerd Font Bold
italic_font      JetBrainsMono Nerd Font Italic
bold_italic_font JetBrainsMono Nerd Font Bold Italic
font_size        11.0
disable_ligatures cursor          # keep ligatures, but not under the cursor
modify_font underline_position 2

# --- Window -------------------------------------------------------------
window_padding_width 10
hide_window_decorations yes       # Hyprland draws the border
confirm_os_window_close 0
background_opacity 1.0            # transparency comes from the window rule
remember_window_size no
initial_window_width  120c
initial_window_height 32c

# --- Behaviour ----------------------------------------------------------
scrollback_lines 20000
enable_audio_bell no
visual_bell_duration 0.0
copy_on_select no
strip_trailing_spaces smart
shell_integration enabled
allow_remote_control no
update_check_interval 0           # packaged by pacman; do not phone home

cursor_shape beam
cursor_blink_interval 0.6
mouse_hide_wait 2.0
url_style curly

# --- Tabs and splits ----------------------------------------------------
tab_bar_edge top
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template "{index}: {title}"
active_tab_font_style bold

map ctrl+shift+t new_tab_with_cwd
map ctrl+shift+enter launch --cwd=current --location=vsplit
map ctrl+shift+minus launch --cwd=current --location=hsplit
map ctrl+shift+left  neighboring_window left
map ctrl+shift+right neighboring_window right
map ctrl+shift+up    neighboring_window up
map ctrl+shift+down  neighboring_window down

# --- Catppuccin Mocha ---------------------------------------------------
foreground              {{css:foreground}}
background              {{css:background}}
selection_foreground    {{css:background}}
selection_background    {{css:rosewater}}

cursor                  {{css:rosewater}}
cursor_text_color       {{css:background}}

url_color               {{css:rosewater}}

active_border_color     {{css:accent}}
inactive_border_color   {{css:muted}}
bell_border_color       {{css:caution}}

wayland_titlebar_color  {{css:background}}

active_tab_foreground   {{css:shadow}}
active_tab_background   {{css:accent}}
inactive_tab_foreground {{css:foreground}}
inactive_tab_background {{css:surface}}
tab_bar_background      {{css:shadow}}

mark1_foreground {{css:background}}
mark1_background {{css:lavender}}
mark2_foreground {{css:background}}
mark2_background {{css:accent}}
mark3_foreground {{css:background}}
mark3_background {{css:info}}

# black
color0 {{css:surface1}}
color8 {{css:surface2}}
# red
color1 {{css:urgent}}
color9 {{css:urgent}}
# green
color2  {{css:success}}
color10 {{css:success}}
# yellow
color3  {{css:caution}}
color11 {{css:caution}}
# blue
color4  {{css:accent_alt}}
color12 {{css:accent_alt}}
# magenta
color5  {{css:pink}}
color13 {{css:pink}}
# cyan
color6  {{css:teal}}
color14 {{css:teal}}
# white
color7  {{css:subtext1}}
color15 {{css:dim}}
