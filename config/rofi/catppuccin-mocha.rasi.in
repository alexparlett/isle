/* Catppuccin Mocha for rofi */

* {
    base:     {{css:background:ff}};
    mantle:   {{css:surface:ff}};
    crust:    {{css:shadow:ff}};
    surface0: {{css:surface_alt:ff}};
    surface1: {{css:surface1:ff}};
    surface2: {{css:surface2:ff}};
    text:     {{css:foreground:ff}};
    subtext0: {{css:dim:ff}};
    overlay0: {{css:muted:ff}};
    mauve:    {{css:accent:ff}};
    blue:     {{css:accent_alt:ff}};
    red:      {{css:urgent:ff}};
    green:    {{css:success:ff}};

    background-color: transparent;
    text-color:       @text;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            38%;
    background-color: @base;
    border:           2px;
    border-color:     @mauve;
    border-radius:    14px;
    location:         center;
    anchor:           center;
    transparency:     "real";
}

mainbox {
    padding:  14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @mantle;
    border:           1px;
    border-color:     @surface0;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @mauve;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:            "Search…";
    placeholder-color:      @overlay0;
    cursor:                 text;
}

message {
    margin:           10px 0 0 0;
    padding:          8px 12px;
    background-color: @mantle;
    border-radius:    10px;
}

textbox {
    text-color: @subtext0;
}

listview {
    lines:         10;
    columns:       1;
    fixed-height:  false;
    scrollbar:     false;
    margin:        12px 0 0 0;
    spacing:       4px;
    cycle:         true;
    dynamic:       true;
}

element {
    padding:       9px 12px;
    spacing:       12px;
    border-radius: 10px;
    cursor:        pointer;
}

element normal.normal   { text-color: @text; }
element alternate.normal { text-color: @text; }

element selected.normal {
    background-color: @surface0;
    text-color:       @mauve;
}

element urgent.normal   { text-color: @red; }
element active.normal   { text-color: @green; }

element-icon {
    size:             1.15em;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}
