/* swaync — Catppuccin Mocha */

@define-color base     {{css:background}};
@define-color mantle   {{css:surface}};
@define-color crust    {{css:shadow}};
@define-color surface0 {{css:surface_alt}};
@define-color surface1 {{css:surface1}};
@define-color text     {{css:foreground}};
@define-color subtext0 {{css:dim}};
@define-color overlay0 {{css:muted}};
@define-color mauve    {{css:accent}};
@define-color blue     {{css:accent_alt}};
@define-color red      {{css:urgent}};
@define-color green    {{css:success}};

* {
  font-family: "JetBrainsMono Nerd Font", sans-serif;
  font-size: 14px;
}

/* Popup notifications ---------------------------------------------------- */

.notification-row {
  outline: none;
}

.notification {
  background: transparent;
  padding: 6px 10px;
  margin: 0;
}

.notification-content {
  background: alpha(@base, 0.96);
  border: 1px solid @surface0;
  border-radius: 14px;
  padding: 14px;
  color: @text;
}

.notification.critical .notification-content {
  border-color: @red;
  box-shadow: inset 3px 0 0 0 @red;
}

.notification.low .notification-content {
  color: @subtext0;
}

.summary {
  font-size: 14px;
  font-weight: 700;
  color: @text;
}

.time {
  font-size: 12px;
  color: @overlay0;
}

.body {
  font-size: 13px;
  color: @subtext0;
}

.close-button {
  background: transparent;
  color: @overlay0;
  border-radius: 8px;
  margin: 6px;
  padding: 2px;
}

.close-button:hover {
  background: @red;
  color: @base;
}

.notification-action {
  background: @surface0;
  color: @text;
  border: none;
  border-radius: 8px;
  margin: 6px 4px 0 4px;
  padding: 6px;
}

.notification-action:hover {
  background: @mauve;
  color: @base;
}

/* Control centre --------------------------------------------------------- */

.control-center {
  background: alpha(@base, 0.94);
  border: 1px solid @surface0;
  border-radius: 16px;
  padding: 14px;
  color: @text;
}

.control-center .notification-content {
  background: @mantle;
}

.widget-title {
  color: @text;
  font-size: 16px;
  font-weight: 700;
  padding: 6px 4px 12px 4px;
}

.widget-title > button {
  background: @surface0;
  color: @subtext0;
  border: none;
  border-radius: 8px;
  padding: 5px 12px;
  font-size: 12px;
}

.widget-title > button:hover {
  background: @red;
  color: @base;
}

.widget-dnd {
  color: @text;
  padding: 6px 4px;
  font-size: 14px;
}

.widget-dnd > switch {
  background: @surface0;
  border: none;
  border-radius: 12px;
}

.widget-dnd > switch:checked {
  background: @mauve;
}

.widget-dnd > switch slider {
  background: @overlay0;
  border-radius: 12px;
}

.widget-dnd > switch:checked slider {
  background: @base;
}

.widget-mpris {
  background: @mantle;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 10px;
}

.widget-mpris-title {
  font-weight: 700;
  color: @text;
}

.widget-mpris-subtitle {
  color: @subtext0;
  font-size: 12px;
}

.widget-volume {
  background: @mantle;
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 10px;
  color: @text;
}

.widget-volume trough {
  background: @surface0;
  border-radius: 8px;
}

.widget-volume highlight {
  background: @blue;
  border-radius: 8px;
}

.blank-window {
  background: transparent;
}
