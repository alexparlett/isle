/* swayosd — the volume / caps-lock popup. Catppuccin Mocha. */

window#osd {
  padding: 12px 20px;
  border-radius: 18px;
  border: 1px solid {{css:surface_alt}};
  background: alpha({{css:background}}, 0.94);
}

window#osd #container {
  margin: 14px;
}

window#osd image,
window#osd label {
  color: {{css:foreground}};
}

window#osd progressbar {
  min-height: 6px;
  border-radius: 999px;
  background: transparent;
}

window#osd trough {
  min-height: 6px;
  border: none;
  border-radius: 999px;
  background: {{css:surface_alt}};
}

window#osd progress {
  min-height: 6px;
  border-radius: 999px;
  background: {{css:accent}};
}
