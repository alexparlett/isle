{
    "label": "lock",
    "action": "hyprlock",
    "text": "Lock",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprshutdown --vt 1",
    "text": "Log out",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}
{
    "label": "reboot",
    "action": "hyprshutdown --vt 1 --post-cmd 'systemctl reboot'",
    "text": "Reboot",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "hyprshutdown --vt 1 --post-cmd 'systemctl poweroff'",
    "text": "Shut down",
    "keybind": "s"
}
