// Spotlight's shell actions: the shortcut or command each runs, its title, its glyph and the
// other words it is found by. An action whose shortcut is not built is left out.
action "lock" title="Lock Screen" glyph="lock" also="lock computer;screen lock"
action "sleep" title="Sleep" glyph="moon-stars" also="suspend"
action "restart" title="Restart…" glyph="arrow-clockwise" also="reboot"
action "shut-down" title="Shut Down…" glyph="power" also="power off;turn off;shutdown"
action "log-out" title="Log Out…" glyph="sign-out" also="sign out;logout"
action "force-quit" title="Force Quit…" glyph="x-circle" also="kill;not responding"
action "dark-mode" title="Dark Mode" glyph="circle-half" also="light mode;appearance;theme"
action "do-not-disturb" title="Do Not Disturb" glyph="moon" also="focus;dnd;quiet"
action "game-mode" title="Game Mode" glyph="game-controller" also="gaming"
action "control-centre" title="Control Centre" glyph="rows" also="control center;quick settings"
action "notification-centre" title="Notification Centre" glyph="bell" also="notification center;notifications"
action "help-search" title="Search Menus" glyph="question" also="help;menu search"
action "next-layout" title="Next Keyboard Layout" glyph="keyboard" also="input source;language"
action "redetect-displays" title="Detect Displays" glyph="monitor" also="monitors;screens"
action "terminal" title="New Terminal Window" glyph="terminal-window" also="shell;console"
action "hide" title="Hide" glyph="eye-slash"
action "hide-others" title="Hide Others" glyph="eye-slash"
action "minimise" title="Minimise" glyph="minus" also="minimize"
action "full-screen" title="Enter Full Screen" glyph="arrows-out-simple" also="fullscreen"
action "tile-left" title="Tile Left" glyph="sidebar-simple" also="snap left;left half"
action "tile-right" title="Tile Right" glyph="sidebar-simple" also="snap right;right half"
action "tile-centre" title="Centre" glyph="rectangle" also="center"
action "fill" title="Fill" glyph="corners-out" also="maximise;maximize"
action "restore" title="Restore Size" glyph="corners-in" also="unmaximise"
action "next-display" title="Move to Next Display" glyph="monitor" also="other screen"
action "desktop-left" title="Previous Desktop" glyph="caret-left" also="space left"
action "desktop-right" title="Next Desktop" glyph="caret-right" also="space right"
