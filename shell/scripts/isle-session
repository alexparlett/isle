#!/usr/bin/env bash
# Runs the shell inside the compositor's session, restarting it if it dies.
#
# Started by hyprland.lua's start hook, so the process sits in the logind session scope:
# polkit then treats it as the active session, which udisks, NetworkManager and logind require.
# A systemd user unit would not be (D17).

SHELL_PATH="${ISLE_SHELL_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/isle}"
# The log outlives the session and the reboot, so a death in the night can be read in the morning; the
# previous session's is kept beside it. A link at the old runtime path stays for anything reading it there.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/isle"
LOG="$LOG_DIR/session.log"
export QT_QPA_PLATFORM=wayland

# One shell per session.
if [[ -f "$XDG_RUNTIME_DIR/isle.pid" ]] && kill -0 "$(cat "$XDG_RUNTIME_DIR/isle.pid")" 2>/dev/null; then
    exit 0
fi
mkdir -p "$LOG_DIR"
[[ -s "$LOG" ]] && mv -f "$LOG" "$LOG.1"
: > "$LOG"
ln -sfn "$LOG" "${XDG_RUNTIME_DIR:-/tmp}/isle.log"
echo "[isle-session] $(date '+%F %T') started" >> "$LOG"
echo $$ > "$XDG_RUNTIME_DIR/isle.pid"
trap 'rm -f "$XDG_RUNTIME_DIR/isle.pid"; kill "$child" 2>/dev/null; exit 0' TERM INT

failures=0
while true; do
    # The compositor this session belongs to is gone: a fresh one starts its own session, with its own
    # environment; this one must not keep bringing a shell up against a dead socket.
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" && ! -S "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock" ]]; then
        echo "[isle-session] compositor gone; stopping" >> "$LOG"; break
    fi
    start=$SECONDS
    qs -p "$SHELL_PATH" >> "$LOG" 2>&1 &
    child=$!
    wait "$child"
    code=$?
    # Six quick deaths in a row means something is broken: the loop backs off to a try every half minute
    # rather than stopping, since a locked session must get its locker back whatever the cause.
    if (( SECONDS - start < 5 )); then failures=$((failures + 1)); else failures=0; fi
    echo "[isle-session] $(date '+%F %T') shell exited ($code) after $((SECONDS - start))s" >> "$LOG"
    if (( failures >= 6 )); then echo "[isle-session] six quick deaths: trying every 30s" >> "$LOG"; sleep 30; else sleep 1; fi
done
rm -f "$XDG_RUNTIME_DIR/isle.pid"
