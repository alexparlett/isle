+/* 27c6:5042 keeps its key under the 51x0 family's record ids and takes that family's longer read request. */
+static gboolean
+goodix_is_51x0_keyed (FpDevice *dev)
+{
+  return g_usb_device_get_pid (fpi_device_get_usb_device (dev)) == 0x5042;
+}
+#define GOODIX_PSK_READ_TYPE(dev)  (goodix_is_51x0_keyed (dev) ? 0xbb020003u : 0xB003u)
+#define GOODIX_PSK_WRITE_TYPE(dev) (goodix_is_51x0_keyed (dev) ? 0xbb010003u : 0xB002u)
+static void
+goodix_cmd_read_psk_hash (FpiSsm *ssm, FpDevice *dev)
+{
+  if (goodix_is_51x0_keyed (dev))
+    goodix_cmd_production_read_long (ssm, dev, GOODIX_PSK_READ_TYPE (dev));
+  else
+    goodix_cmd_production_read (ssm, dev, GOODIX_PSK_READ_TYPE (dev));
+}
