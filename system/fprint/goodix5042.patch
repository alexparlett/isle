+/* ========================================================================
+ * Touch by polling, for firmware that raises no FDT events
+ * ======================================================================== */
+
+/* The twelve channel readings of a manual FDT reply, logged, and compared to the open-time baseline;
+ * returns the channels that moved by more than `delta` as a bitmask. */
+static guint16
+goodix_plain_touch_flag (FpiDeviceGoodix53x5 *self,
+                         const guint8        *readings,
+                         guint16              delta)
+{
+  guint16 flag = 0;
+  g_autoptr(GString) line = g_string_new (NULL);
+
+  for (int i = 0; i < 12; i++)
+    {
+      guint16 base = self->plain_base[i * 2] | ((guint16) self->plain_base[i * 2 + 1] << 8);
+      guint16 now = readings[i * 2] | ((guint16) readings[i * 2 + 1] << 8);
+      gint d = abs ((gint) (now >> 1) - (gint) (base >> 1));
+
+      g_string_append_printf (line, "%d%s ", d, (guint16) d > delta ? "*" : "");
+      if ((guint16) d > delta)
+        flag |= 1 << i;
+    }
+  fp_dbg ("FDT poll deltas (limit %u): %s", delta, line->str);
+  return flag;
+}
+
+/* A poll that saw nothing: come back shortly, unless the operation was cancelled meanwhile. */
+static gboolean
+goodix_plain_poll_again (FpiDeviceGoodix53x5 *self,
+                         FpiSsm              *ssm,
+                         int                  setup_state)
+{
+  if (self->cancel && g_cancellable_is_cancelled (self->cancel))
+    {
+      if (self->action_result_reported)
+        fpi_ssm_jump_to_state (ssm, self->blocking_shutdown_state);
+      else
+        fpi_ssm_mark_failed (ssm, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED, "Cancelled"));
+      return TRUE;
+    }
+  fpi_ssm_jump_to_state_delayed (ssm, setup_state, 120);
+  return TRUE;
+}
