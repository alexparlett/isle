+/* ========================================================================
+ * Touch by polling frames, for firmware that raises no FDT events
+ * ======================================================================== */
+
+/* A plain firmware's image payload: five bytes of head, the raw12 frame, four bytes of checksum. */
+static guint8 *
+goodix_plain_frame_data (const guint8 *pl, gsize pl_len, gsize *out_len)
+{
+  if (pl_len < 9)
+    return NULL;
+  *out_len = pl_len - 9;
+  return g_memdup2 (pl + 5, pl_len - 9);
+}
+
+/* Mean absolute difference between two frames, in 12-bit units. */
+static gdouble
+goodix_plain_frame_diff (const guint16 *a, const guint16 *b)
+{
+  gdouble sum = 0;
+
+  for (gsize i = 0; i < GOODIX_SENSOR_PIXELS; i++)
+    sum += abs ((gint) a[i] - (gint) b[i]);
+  return sum / GOODIX_SENSOR_PIXELS;
+}
+
+/* The frame just received, decoded; NULL (and the SSM failed) when it is not one. */
+static guint16 *
+goodix_plain_poll_frame (FpiSsm *ssm, FpDevice *dev)
+{
+  guint8 cat, cmd;
+  const guint8 *pl;
+  gsize pl_len, len;
+  g_autofree guint8 *data = NULL;
+  guint16 *img;
+
+  if (!goodix_parse_reply (dev, &cat, &cmd, &pl, &pl_len, NULL) ||
+      (data = goodix_plain_frame_data (pl, pl_len, &len)) == NULL ||
+      (img = goodix_device_decode_image (data, len)) == NULL)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO, "Failed to read a polled frame"));
+      return NULL;
+    }
+  return img;
+}
+
+/* The difference a finger makes: well above the frame-to-frame noise measured at the start of the wait. */
+static gdouble
+goodix_plain_touch_threshold (FpiDeviceGoodix53x5 *self)
+{
+  return MAX (12.0, self->plain_noise * 4.0);
+}
+
+/* A poll that saw nothing: come back shortly, unless the operation was cancelled meanwhile. */
+static void
+goodix_plain_poll_again (FpiDeviceGoodix53x5 *self,
+                         FpiSsm              *ssm,
+                         int                  setup_state)
+{
+  if (self->cancel && g_cancellable_is_cancelled (self->cancel))
+    {
+      if (self->action_result_reported)
+        fpi_ssm_jump_to_state (ssm, self->blocking_shutdown_state);
+      else
+        fpi_ssm_mark_failed (ssm, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED, "Cancelled"));
+      return;
+    }
+  fpi_ssm_jump_to_state_delayed (ssm, setup_state, 100);
+}
