[Unit]
Description=Sync the Isle checkout into the installed shell (development)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# tools/install.sh --dev writes the checkout's path here.
Environment=ISLE_SRC=@SRC@
ExecStart=@SRC@/tools/dev-sync.sh --watch
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
